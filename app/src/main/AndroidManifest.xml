<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Asked for at the moment the person turns the digest on, never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
         The one thing that needs this: the model download in Ask, started by a
         button press. Nothing else in the app opens a socket.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
         Health Connect. Read-only: there is no WRITE_* permission here because
         Tide never writes to it. Each is declared for real, because the
         Settings screen and Body both check exactly this set.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <!--
         Package visibility (Android 11+). Without this, resolving the Health
         Connect permission screen or the Play Store "get it" intent can fail
         silently: the button appears to do nothing rather than erroring.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tide">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Tide"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                 Health Connect's own permission screen links out to "why does
                 this app want this", and sends that tap here. Without an
                 activity that answers to this action, some Health Connect
                 versions refuse to show the permission screen at all, which
                 is a request that silently goes nowhere rather than a crash:
                 exactly what "Connect Health Connect" was doing.
            -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

            <!-- The same link, under Android 14's newer action name. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>
    </application>
</manifest>
