<?xml version="1.0" encoding="utf-8"?>
<!--
  Certificate hashes for the Google Play Services downloadable-fonts provider.
  These are NOT placeholders to be invented: copy them verbatim from the current
  androidx sample at
  https://github.com/android/compose-samples (search font_certs.xml).
  Wrong values fail silently at runtime and the font just never loads.
-->
<resources>
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>
    <string-array name="com_google_android_gms_fonts_certs_dev">
        <item>TODO_PASTE_DEV_CERT_HASH</item>
    </string-array>
    <string-array name="com_google_android_gms_fonts_certs_prod">
        <item>TODO_PASTE_PROD_CERT_HASH</item>
    </string-array>
</resources>
